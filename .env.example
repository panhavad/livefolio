# Local host port
LIVEFOLIO_PORT=8080

# Use ghcr.io/panhavad/livefolio:latest for automatic production updates.
LIVEFOLIO_IMAGE=livefolio:local

# Enable only when LIVEFOLIO_IMAGE points to a remote registry image.
AUTO_UPDATE=false

# How often Watchtower checks the registry for a new image.
UPDATE_INTERVAL_SECONDS=300

# Only needed if the GHCR package is private. Use a token with read:packages.
GHCR_USERNAME=
GHCR_TOKEN=
