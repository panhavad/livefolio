# Local host port
LIVEFOLIO_PORT=8080

# Use ghcr.io/OWNER/REPOSITORY:latest for automatic production updates.
LIVEFOLIO_IMAGE=livefolio:local

# Enable only when LIVEFOLIO_IMAGE points to a remote registry image.
AUTO_UPDATE=false

# How often Watchtower checks the registry for a new image.
UPDATE_INTERVAL_SECONDS=300

# Path to the Docker config created by `docker login` on the deployment host.
DOCKER_CONFIG_PATH=/root/.docker/config.json
